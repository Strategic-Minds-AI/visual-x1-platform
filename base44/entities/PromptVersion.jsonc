{
  "name": "PromptVersion",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the project this prompt belongs to"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number"
    },
    "prompt_text": {
      "type": "string",
      "description": "The prompt text"
    },
    "prompt_type": {
      "type": "string",
      "enum": [
        "idea",
        "refined",
        "system",
        "chain"
      ],
      "default": "refined",
      "description": "Type of prompt"
    },
    "parent_version_id": {
      "type": "string",
      "description": "ID of the parent prompt version"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived",
        "rejected"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this version"
    }
  },
  "required": [
    "project_id",
    "prompt_text",
    "prompt_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}