{
  "name": "PromptVersion",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the project this prompt belongs to. Module records use 'system'."
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number"
    },
    "prompt_text": {
      "type": "string",
      "description": "The prompt text"
    },
    "prompt_type": {
      "type": "string",
      "enum": [
        "idea",
        "refined",
        "system",
        "chain"
      ],
      "default": "refined",
      "description": "Type of prompt"
    },
    "parent_version_id": {
      "type": "string",
      "description": "ID of the parent prompt version, used as the rollback pointer"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived",
        "rejected"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this version"
    },
    "module_id": {
      "type": "string",
      "description": "Stable module identifier for orchestrated pipeline modules (e.g. MODULE-A-BRIEF-INTERPRETER, MISSION-CONTRACT)"
    },
    "purpose": {
      "type": "string",
      "description": "What this module is for"
    },
    "inputs_json": {
      "type": "string",
      "description": "JSON array of the typed inputs this module accepts"
    },
    "output_schema_json": {
      "type": "string",
      "description": "JSON schema of the structured output this module must return"
    },
    "constraints": {
      "type": "string",
      "description": "Hard rules the module must obey"
    },
    "tool_requirements": {
      "type": "string",
      "description": "Tools the module needs to do its job"
    },
    "authorization_boundaries": {
      "type": "string",
      "description": "What this module is not allowed to do"
    },
    "acceptance_criteria": {
      "type": "string",
      "description": "How the module's output is judged"
    },
    "failure_behavior": {
      "type": "string",
      "description": "What happens when the module cannot produce a valid output"
    },
    "eval_cases_json": {
      "type": "string",
      "description": "JSON array of evaluation cases used to check the module"
    },
    "cost_budget": {
      "type": "string",
      "description": "Model calls and rough token budget per run"
    },
    "latency_budget_ms": {
      "type": "number",
      "default": 60000,
      "description": "Stage timeout in milliseconds"
    },
    "provenance": {
      "type": "string",
      "description": "Where this module definition came from"
    },
    "changelog": {
      "type": "string",
      "description": "What changed in this version"
    },
    "stage_order": {
      "type": "number",
      "default": 0,
      "description": "Position of this module in the pipeline"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the orchestrator should load this version"
    }
  },
  "required": [
    "prompt_text",
    "prompt_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}