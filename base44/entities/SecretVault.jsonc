{
  "name": "SecretVault",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string",
      "description": "Name of the external tool or service (e.g., OpenAI, Stripe, GitHub)"
    },
    "secret_key": {
      "type": "string",
      "description": "The key identifier (e.g., API_KEY, WEBHOOK_SECRET, DATABASE_URL)"
    },
    "secret_value": {
      "type": "string",
      "description": "The actual secret value \u2014 masked in UI, only revealed on explicit view"
    },
    "description": {
      "type": "string",
      "description": "What this secret is used for"
    },
    "category": {
      "type": "string",
      "enum": [
        "api_key",
        "webhook_secret",
        "oauth_token",
        "database_url",
        "encryption_key",
        "other"
      ],
      "default": "api_key",
      "description": "Type of secret"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "development"
      ],
      "default": "production",
      "description": "Which environment this secret is for"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this secret is currently in use"
    },
    "last_rotated": {
      "type": "string",
      "format": "date-time",
      "description": "When the secret was last rotated"
    },
    "rotation_reminder_days": {
      "type": "number",
      "default": 90,
      "description": "Days before rotation is recommended"
    },
    "access_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this secret has been viewed"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time",
      "description": "When this secret was last viewed"
    }
  },
  "required": [
    "tool_name",
    "secret_key",
    "secret_value",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}