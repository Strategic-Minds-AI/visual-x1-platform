{
  "name": "SecretVault",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string",
      "description": "Name of the external tool or service (e.g., OpenAI, Stripe, GitHub)"
    },
    "secret_key": {
      "type": "string",
      "description": "The key identifier (e.g., API_KEY, WEBHOOK_SECRET, DATABASE_URL)"
    },
    "secret_value": {
      "type": "string",
      "description": "Leave empty: the real value belongs in the platform's Secrets page. A value stored here is only a non-sensitive reference or an already-rotated placeholder."
    },
    "refers_to": {
      "type": "string",
      "description": "Where the real value lives: the platform secret name, the provider's console, or the operator's own vault"
    },
    "description": {
      "type": "string",
      "description": "What this secret is used for"
    },
    "category": {
      "type": "string",
      "enum": [
        "api_key",
        "webhook_secret",
        "oauth_token",
        "database_url",
        "encryption_key",
        "other"
      ],
      "default": "api_key",
      "description": "Type of secret"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "development"
      ],
      "default": "production",
      "description": "Which environment this secret is for"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this secret is currently in use"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "operator",
        "guardian",
        "system"
      ],
      "default": "operator",
      "description": "Who may read this entry: the operator, the guardian agent, or the system's functions"
    },
    "guardian_only": {
      "type": "boolean",
      "default": false,
      "description": "When true, only the guardian agent and admins may read this entry, and every read is audited"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What this credential permits, so least privilege is visible"
    },
    "rotation_owner": {
      "type": "string",
      "description": "Who rotates this credential"
    },
    "last_rotated": {
      "type": "string",
      "format": "date-time",
      "description": "When the secret was last rotated"
    },
    "rotation_reminder_days": {
      "type": "number",
      "default": 90,
      "description": "Days before rotation is recommended"
    },
    "access_count": {
      "type": "number",
      "default": 0,
      "description": "How many times this secret has been viewed"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time",
      "description": "When this secret was last viewed"
    },
    "last_accessed_by": {
      "type": "string",
      "description": "Who last read this entry, so vault access is attributable"
    },
    "audit_trail_json": {
      "type": "string",
      "description": "JSON array of the last vault reads: who, when, and why"
    }
  },
  "required": [
    "tool_name",
    "secret_key",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}