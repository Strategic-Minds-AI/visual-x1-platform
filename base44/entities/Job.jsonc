{
  "name": "Job",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title of the job"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what the job requires"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "in_progress",
        "review",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "open",
      "description": "Current state of the job on the board"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priority level used for assignment ordering"
    },
    "type": {
      "type": "string",
      "enum": [
        "research",
        "analysis",
        "task",
        "review",
        "creative",
        "sync",
        "build",
        "funnel",
        "deploy"
      ],
      "default": "task",
      "description": "Kind of work the job represents"
    },
    "assigned_agent_id": {
      "type": "string",
      "description": "Id of the agent assigned to the job"
    },
    "result": {
      "type": "string",
      "description": "Outcome or output produced when the job is completed"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional deadline for the job"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags for filtering and grouping"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Completion percentage from 0 to 100"
    },
    "progress_notes": {
      "type": "string",
      "description": "Running log of status updates and progress notes from agents"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the job was assigned to an agent"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the agent started working on the job"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the job was marked completed"
    },
    "applicant_count": {
      "type": "number",
      "default": 0,
      "description": "Number of agents that have shown interest or been considered"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}