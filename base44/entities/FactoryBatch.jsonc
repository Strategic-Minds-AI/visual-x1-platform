{
  "name": "FactoryBatch",
  "type": "object",
  "properties": {
    "sentence": {
      "type": "string",
      "description": "The one-sentence input that started the production run"
    },
    "industry": {
      "type": "string",
      "description": "Target industry for this batch"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "generating",
        "rendering",
        "validating",
        "refining",
        "ready",
        "needs_refinement",
        "failed"
      ],
      "default": "planning"
    },
    "current_step": {
      "type": "string",
      "description": "Current pipeline step"
    },
    "prompt_result": {
      "type": "string",
      "description": "JSON of the converted prompt with site type, audience, keywords"
    },
    "spec_result": {
      "type": "string",
      "description": "JSON of the compiled product specification"
    },
    "qa_result": {
      "type": "string",
      "description": "JSON of the spec-level QA audit scores and findings"
    },
    "validation_result": {
      "type": "string",
      "description": "JSON of the independent validation of the rendered HTML"
    },
    "refinement_suggestions": {
      "type": "string",
      "description": "JSON of QA feedback loop suggestions for improvement"
    },
    "rendered": {
      "type": "boolean",
      "default": false,
      "description": "Whether HTML was successfully rendered"
    },
    "html_length": {
      "type": "number",
      "default": 0,
      "description": "Size of rendered HTML in bytes (for tracking without storing full HTML)"
    },
    "quality_score": {
      "type": "number",
      "default": 0,
      "description": "Composite quality score 0-100 from independent validation (target: 95+)"
    },
    "spec_score": {
      "type": "number",
      "default": 0,
      "description": "Spec-level QA score 0-100 (before rendering)"
    },
    "repair_round": {
      "type": "number",
      "default": 0,
      "description": "Current repair round (max 3)"
    },
    "target_variant_count": {
      "type": "number",
      "default": 100,
      "description": "How many SEO variants to generate"
    },
    "target_backlink_count": {
      "type": "number",
      "default": 50,
      "description": "How many backlink sites to create"
    },
    "created_variants": {
      "type": "number",
      "default": 0,
      "description": "Number of SEO variants actually created"
    },
    "created_backlinks": {
      "type": "number",
      "default": 0,
      "description": "Number of backlink sites actually created"
    },
    "visual_approval": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Manual visual quality approval before the live deployment gate"
    },
    "approval_notes": {
      "type": "string",
      "description": "Reviewer notes on the visual quality decision"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the visual approval decision was recorded"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of the reviewer who approved or rejected"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if the pipeline failed"
    }
  },
  "required": [
    "sentence",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}