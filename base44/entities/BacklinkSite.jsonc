{
  "name": "BacklinkSite",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "ID of the parent factory batch"
    },
    "industry": {
      "type": "string",
      "description": "Service industry this backlink site targets"
    },
    "site_type": {
      "type": "string",
      "enum": [
        "directory",
        "blog_post",
        "landing_page",
        "local_page",
        "review_site",
        "comparison_page"
      ],
      "default": "directory",
      "description": "Type of backlink website"
    },
    "target_keyword": {
      "type": "string",
      "description": "Primary keyword for this backlink site"
    },
    "target_location": {
      "type": "string",
      "description": "Geographic location targeted"
    },
    "content": {
      "type": "string",
      "description": "Generated content for the backlink page"
    },
    "backlink_url": {
      "type": "string",
      "description": "URL this site links back to (the main site)"
    },
    "site_url": {
      "type": "string",
      "description": "Public URL of the backlink site itself, used for health checks"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "created",
        "deployed",
        "failed"
      ],
      "default": "pending"
    },
    "domain_authority": {
      "type": "number",
      "default": 0,
      "description": "Target domain authority score"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "not_live",
        "down"
      ],
      "default": "unknown",
      "description": "Result of the last live health check on site_url"
    },
    "http_status": {
      "type": "number",
      "description": "HTTP status code returned by the last health check"
    },
    "response_ms": {
      "type": "number",
      "description": "Response time of the last health check in milliseconds"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When site_url was last checked"
    },
    "health_note": {
      "type": "string",
      "description": "What the health check observed, or why the site needs attention"
    }
  },
  "required": [
    "batch_id",
    "industry",
    "target_keyword",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}