{
  "name": "SEOVariant",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "ID of the parent factory batch (a mass-launch wave is one batch)"
    },
    "variant_number": {
      "type": "number",
      "default": 1,
      "description": "Sequential variant number within the batch"
    },
    "target_keyword": {
      "type": "string",
      "description": "Primary SEO keyword this variant targets"
    },
    "target_location": {
      "type": "string",
      "description": "Geographic location this variant targets (city, state)"
    },
    "content": {
      "type": "string",
      "description": "The generated variant content or prompt"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "generated",
        "deployed",
        "failed"
      ],
      "default": "pending"
    },
    "google_score": {
      "type": "number",
      "default": 0,
      "description": "Google SEO readiness score 0-100"
    },
    "url": {
      "type": "string",
      "description": "Deployed URL of this variant"
    },
    "funnel_type": {
      "type": "string",
      "description": "Lead funnel type used on this variant"
    },
    "gsc_site": {
      "type": "string",
      "description": "Search Console property this page's performance was measured against"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Search impressions in the last reporting window"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Search clicks in the last reporting window"
    },
    "ctr": {
      "type": "number",
      "default": 0,
      "description": "Click-through rate as a percentage"
    },
    "avg_position": {
      "type": "number",
      "default": 0,
      "description": "Impression-weighted average search position. 0 means not measured yet."
    },
    "top_query": {
      "type": "string",
      "description": "The search query sending this page the most impressions"
    },
    "last_gsc_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Search Console performance was last pulled for this page"
    }
  },
  "required": [
    "batch_id",
    "target_keyword",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}